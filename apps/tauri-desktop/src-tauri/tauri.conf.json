{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Trilium Notes",
  "version": "0.99.4",
  "identifier": "org.triliumnext.trilium",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ../../rust-server && cargo build --release",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [
      "binaries/trilium-rust"
    ],
    "copyright": "AGPL-3.0-only",
    "category": "Productivity",
    "shortDescription": "Build your personal knowledge base with Trilium Notes",
    "longDescription": "Trilium Notes is a hierarchical note taking application with focus on building large personal knowledge bases.",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "Trilium Notes",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:8081 ws://localhost:8081 http://localhost:8080 ws://localhost:8080 data: blob:"
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
